    {
      "name": "2. Productos (ADMIN)",
      "description": "Alta, modificación y baja de productos con el token de admin.",
      "item": [
        {
          "name": "Crear producto (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos"
              ]
            },
            "description": "Responde 201 con la cabecera `Location`. Guarda el id en `productoCreadoId`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Lámpara LED\",\n  \"descripcion\": \"Lámpara de escritorio\",\n  \"precio\": 19.99,\n  \"stock\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
